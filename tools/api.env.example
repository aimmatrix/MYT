# Copy to a PRIVATE file outside the shared Lightfern folder, e.g. /private/tmp/myt-secrets/api.env.
# Run with Node 22: node --env-file=/private/tmp/myt-secrets/api.env tools/refresh-sources.mjs
TICKETMASTER_API_KEY=
SKIDDLE_API_KEY=
SERPAPI_API_KEY=
GOOGLE_PLACES_API_KEY=
EVENTBRITE_PRIVATE_TOKEN=
# Optional comma-separated known public event IDs; Eventbrite links already in the catalog are used automatically.
EVENTBRITE_EVENT_IDS=
# TMDB API Read Access Token, not the short v3 API key:
TMDB_READ_TOKEN=
# Copy these values exactly from the MovieGlu credentials email (UK evaluation):
MOVIEGLU_CLIENT=
MOVIEGLU_API_KEY=
MOVIEGLU_AUTHORIZATION=
MOVIEGLU_API_VERSION=
